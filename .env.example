# Public identity
AGENT_NAME=Research Agent World Node
PUBLIC_BASE_URL=https://agent.example.com

# Persistence
POSTGRES_DB=agentworld
POSTGRES_USER=agentworld
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://agentworld:replace-with-a-long-random-secret@postgres:5432/agentworld

# Model provider is intentionally not fixed yet.
# Add provider-specific secrets on the host only; never commit real values.
MODEL_PROVIDER=
MODEL_API_KEY=

# GitHub integration (host secret; optional until collaboration worker lands)
GITHUB_TOKEN=
